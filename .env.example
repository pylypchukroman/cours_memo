# Supabase
# Cloud project:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local Supabase (after `pnpm supabase:start`; copy keys from `pnpm supabase:status`):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
# Cheapest GPT-5.4 model that still supports structured extraction.
OPENAI_EXTRACTION_MODEL=gpt-5.4-nano
# Write explanations in this language. The interface stays English.
STUDY_EXPLANATION_LANGUAGE=English

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
